__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.swp
*~

# Reproducible source/configuration is versioned; large research assets remain
# in place and are referenced by immutable run manifests and SHA-256 seals.
/results/*
!/results/project_status.json
*.bag
*.bag.active
*.pt
*.pth
*.ckpt
*.npy
*.npz
*.zarr/
*.png
*.jpg
*.jpeg
*.pdf
*.mp4
*.db
*.so
*.o
build/
devel/
install/

# Keep paper figures and report PDFs in Git; raw runs remain local above.
!docs/**/*.png
!docs/**/*.jpg
!docs/**/*.jpeg
!docs/**/*.pdf

# External source checkouts and bulk handoff archives have separate provenance.
/external/
/third_party/
/docs/exports/*.zip

# Never version local authentication material.
.env
.env.*
!.env.example
*.pem
*.key
id_rsa
id_ed25519
credentials.json
hosts.yml
